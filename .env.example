# Copia este archivo a .env y completa los valores (nunca subas .env a git).
#
# Cadena de conexión Postgres de Supabase:
# Dashboard → proyecto pulso-legislativo → botón "Connect" → "Session pooler".
# Usa el pooler (no la conexión directa) porque GitHub Actions no tiene IPv6.
DATABASE_URL=postgresql://postgres.elyunblhidzgaowzljmx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opcional: segundos de espera entre requests a una misma fuente (cortesía con los servidores)
PAUSA_SEGUNDOS=0.3

# Guion con Claude (si falta, se usa la plantilla fija)
ANTHROPIC_API_KEY=

# Voz humana con ElevenLabs (si falta, se usa edge-tts, que suena más sintético)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODELO=eleven_multilingual_v2
